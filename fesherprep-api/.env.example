# Spring loads this file as Java properties: do not wrap values in quotes.
APP_PROFILE=dev
SERVER_PORT=8080

# Supabase Dashboard > Connect > Session pooler (copy your actual host).
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Use the least-privileged runtime role provisioned by docs/security/database-least-privilege.sql.
# Keep the postgres owner account only for reviewed migrations/administration.
SUPABASE_DB_USERNAME=fresherprep_runtime.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD

# Supabase Dashboard > Project Settings > API Keys.
# Use a backend-only secret key (sb_secret_...) or legacy service_role key.
# Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_SECRET_KEY=REPLACE_WITH_YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=pet-assets
SUPABASE_STORAGE_MAX_FILE_SIZE=2097152

# Generate at least 32 random bytes and encode them with Base64.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET
JWT_ISSUER=fresherprep-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# Redis cache. In Docker, use the Redis container name on the shared network.
REDIS_HOST=fresherprep-redis
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s

# Adaptive Java knowledge challenge after repeated failed login attempts.
LOGIN_CHALLENGE_ENABLED=true
LOGIN_CHALLENGE_FAILURE_THRESHOLD=3
LOGIN_CHALLENGE_TTL=PT3M
LOGIN_CHALLENGE_FAILURE_RETENTION=PT15M
LOGIN_CHALLENGE_MAX_CLIENTS=10000
